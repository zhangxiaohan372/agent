{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Agent CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/agent.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api.app:app",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}